# ====== Banco de dados ======
DATABASE_URL="file:./dev.db"

# ====== Alchemy (ETH, BASE, ARB, SOL opcional) — ver docs/99-setup-chaves.md ======
ALCHEMY_ETH_KEY=
ALCHEMY_BASE_KEY=
ALCHEMY_ARB_KEY=
ALCHEMY_SOL_KEY=

# ====== Helius (SOL opcional / alternativa dedicada) ======
HELIUS_KEY=

# ====== CoinGecko (opcional — sem chave a API pública é usada com limite menor) ======
COINGECKO_KEY=

# ====== Agendamento ======
# Expressão cron para o job de sync automático (default: a cada 30 minutos)
SYNC_CRON_EXPR=*/30 * * * *
