{
  "name": "criptoir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:migrate": "node --experimental-strip-types scripts/db-migrate.ts",
    "db:push": "node --experimental-strip-types scripts/db-migrate.ts --push",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "orch:list": "node --experimental-strip-types tools/orchestrator/list.ts",
    "orch:pick": "node --experimental-strip-types tools/orchestrator/pick.ts",
    "orch:review": "node --experimental-strip-types tools/orchestrator/review.ts",
    "orch:verify": "node --experimental-strip-types tools/orchestrator/verify.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:providers": "node --experimental-strip-types scripts/check-providers.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.5.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "execa": "^9.6.1",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.0.2",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
